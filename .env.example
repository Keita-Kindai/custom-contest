POSTGRES_DB=custom_contest
POSTGRES_USER=custom_contest
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://custom_contest:local-development-only@localhost:5432/custom_contest

# 認証（ADR-0009）。OAuthアプリの登録は人が行う。未設定なら/signinは「未設定」と表示する。
# AUTH_SECRET は `openssl rand -base64 32` で生成する。commitしない。
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
