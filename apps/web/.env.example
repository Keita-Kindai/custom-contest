# PostgreSQL 18 example. Create apps/web/.env.local and adjust the database/user.
DATABASE_URL=postgresql://localhost:5432/custom_contest

# Enable only for the LAN demo, local development, and automated tests.
CUSTOM_CONTEST_ENABLE_FAKE_EVIDENCE=1

# Auth.js (ADR-0009). openssl rand -base64 32 で AUTH_SECRET を作る。
# providerは揃っているものだけ /signin に出る。片方だけでも動く。
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
